{
  "name": "hypergraph-viz",
  "version": "0.2.1",
  "description": "Hypergraph rendering on G6 v5: hypergraph layout, node-only bubble sets, hover and selection, plus an explorer UI with database and inspector panels and an admin console",
  "license": "MIT",
  "author": "yuxizhe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxizhe/HypergraphViewer.git",
    "directory": "packages/hypergraph-viz"
  },
  "keywords": [
    "hypergraph",
    "g6",
    "bubble-sets",
    "layout",
    "visualization"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./explorer": {
      "import": {
        "types": "./dist/explorer.d.ts",
        "default": "./dist/explorer.js"
      },
      "require": {
        "types": "./dist/explorer.d.cts",
        "default": "./dist/explorer.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./global": "./dist/hypergraph-viz.global.js",
    "./style.css": "./dist/style.css"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "explorer": [
        "./dist/explorer.d.ts"
      ],
      "admin": [
        "./dist/admin.d.ts"
      ],
      "node": [
        "./dist/node.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@antv/g6": ">=5.0.49 <5.1.0",
    "playwright": ">=1.40",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antv/g6": "5.0.49",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.16",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
