{
  "name": "hypergraph-viz",
  "version": "0.1.1",
  "description": "Hypergraph rendering on G6 v5: hypergraph layout, node-only bubble sets, hover and selection",
  "license": "MIT",
  "author": "yuxizhe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxizhe/HypergraphViewer.git",
    "directory": "packages/hypergraph-viz"
  },
  "keywords": [
    "hypergraph",
    "g6",
    "bubble-sets",
    "layout",
    "visualization"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./global": "./dist/hypergraph-viz.global.js"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "sync:hypergraph-db": "node scripts/copy-global.mjs ../../../Hypergraph-DB/hyperdb/templates"
  },
  "peerDependencies": {
    "@antv/g6": ">=5.0.49 <5.1.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antv/g6": "5.0.49",
    "@types/react": "^19.1.16",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
